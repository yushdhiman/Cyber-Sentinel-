# Backend server configuration
PORT=10000
NODE_ENV=production

# Initial administrator provisioning (set once during deployment)
INITIAL_ADMIN_EMAIL=admin@sentinel.ai
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_production_password

# JWT authentication
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=2h

# Frontend URL
CORS_ORIGIN=http://localhost:5173

# Optional: Gemini API for advanced AI analysis
GEMINI_API_KEY=

# Optional: SMTP email configuration (for OTP verification)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_FROM=noreply@example.com

# Optional: Twilio SMS configuration (for OTP verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

